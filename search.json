---
layout: null
---
[
  {% assign first_entry = true %}
  {% for page in site.pages %}
    {% assign page_url = page.url | default: "" %}
    {% assign page_title = page.title | default: "" %}
    {% unless page_title == "" or page_url contains "404" or page_url contains "search.json" or page_url contains "atom.xml" or page_url contains "feed.xml" or page_url contains "sitemap.xml" or page_url contains "robots.txt" or page_url contains "/assets/" or page_url contains "/images/" or page_url contains ".css" or page_url contains ".js" or page_url contains ".png" or page_url contains ".jpg" or page_url contains ".jpeg" or page_url contains ".gif" or page_url contains ".webp" or page_url contains ".svg" or page_url contains ".ico" or page_url contains ".woff" or page_url contains ".woff2" or page_url contains ".ttf" or page_url contains ".pdf" %}
      {% unless first_entry %},{% endunless %}
      {
        "title": {{ page_title | jsonify }},
        "url": {{ page_url | relative_url | jsonify }},
        "type": "page",
        "category": {{ page.category | default: "Trang" | jsonify }},
        "tags": {{ page.tags | default: empty | jsonify }},
        "summary": {{ page.description | default: page.excerpt | strip_html | strip_newlines | jsonify }},
        "content": {{ page.content | default: "" | strip_html | strip_newlines | truncate: 1200 | jsonify }}
      }
      {% assign first_entry = false %}
    {% endunless %}
  {% endfor %}
  {% for post in site.posts %}
    {% unless first_entry %},{% endunless %}
    {
      "title": {{ post.title | jsonify }},
      "url": {{ post.url | relative_url | jsonify }},
      "type": "post",
      "category": {{ post.category | default: post.categories.first | default: "Bài viết" | jsonify }},
      "tags": {{ post.tags | default: empty | jsonify }},
      "summary": {{ post.description | default: post.excerpt | strip_html | strip_newlines | jsonify }},
      "content": {{ post.content | strip_html | strip_newlines | truncate: 5000 | jsonify }}
    }
    {% assign first_entry = false %}
  {% endfor %}
]
